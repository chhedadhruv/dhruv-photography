# Copy to `.env.local` and fill in. `.env.local` is gitignored.

# ---------------------------------------------------------------------------
# Public (bundled into the client -- never put a secret behind NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Canonical origin. Used for canonical URLs, sitemap entries, and OG tags, so it must be
# the real public origin in production or search engines will index the wrong host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where image derivatives are served from.
#   - Local development before R2 exists:  /images
#   - Production: your R2 custom domain,   https://images.dhruvchheda.com
# Prefer a custom domain over the r2.dev URL, which is rate-limited.
NEXT_PUBLIC_IMAGE_BASE_URL=/images

# ---------------------------------------------------------------------------
# Private -- used only by `yarn ingest`, never by the site build or the browser
# ---------------------------------------------------------------------------

# From the Cloudflare dashboard: R2 > Overview (account ID) and R2 > Manage API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dhruv-photography
